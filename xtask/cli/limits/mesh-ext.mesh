#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x = 200) in;
layout(triangles, max_vertices = 300, max_primitives = 300) out;
void main()
{
    SetMeshOutputsEXT(3, 1);
    gl_MeshVerticesEXT[gl_LocalInvocationIndex % 3].gl_Position = vec4(0.0);
    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
}
