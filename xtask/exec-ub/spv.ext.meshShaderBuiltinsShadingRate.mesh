#version 460

#define MAX_VER  81
#define MAX_PRIM 32

#define BARRIER() \
    memoryBarrierShared(); \
    barrier();

#extension GL_EXT_mesh_shader : enable
#extension GL_EXT_fragment_shading_rate : enable

layout(local_size_x = 32, local_size_y=1, local_size_z=1) in;

layout(max_vertices=MAX_VER) out;
layout(max_primitives=MAX_PRIM) out;
layout(triangles) out;

void main()
{
    uint iid = gl_LocalInvocationID.x;
    uint gid = gl_WorkGroupID.x;
    uvec3 numWorkGrous = gl_NumWorkGroups;
    uint vertexCount = MAX_VER;
    uint primitiveCount = MAX_PRIM;
    SetMeshOutputsEXT(vertexCount, primitiveCount);

    gl_MeshVerticesEXT[iid].gl_Position = vec4(1.0);
    gl_MeshVerticesEXT[iid].gl_PointSize = 2.0;
    gl_MeshVerticesEXT[iid].gl_ClipDistance[0] = 3.0;
    gl_MeshVerticesEXT[iid].gl_ClipDistance[1] = 3.0;
    gl_MeshVerticesEXT[iid].gl_ClipDistance[2] = 3.0;
    gl_MeshVerticesEXT[iid].gl_ClipDistance[3] = 3.0;
    gl_MeshVerticesEXT[iid].gl_CullDistance[0] = 4.0;
    gl_MeshVerticesEXT[iid].gl_CullDistance[1] = 4.0;
    gl_MeshVerticesEXT[iid].gl_CullDistance[2] = 4.0;

    BARRIER();

    gl_MeshPrimitivesEXT[iid].gl_PrimitiveID = 6;
    gl_MeshPrimitivesEXT[iid].gl_Layer = 0;
    gl_MeshPrimitivesEXT[iid].gl_ViewportIndex = 0;
    gl_MeshPrimitivesEXT[iid].gl_CullPrimitiveEXT = false;
    gl_PrimitiveTriangleIndicesEXT[iid] = uvec3(iid);
    gl_MeshPrimitivesEXT[iid].gl_PrimitiveShadingRateEXT = 0;

    BARRIER();

    if (iid == 0) {
        gl_PrimitiveTriangleIndicesEXT[0] = uvec3(257 % MAX_VER);
        gl_PrimitiveTriangleIndicesEXT[primitiveCount - 1] = uvec3(2);
        gl_PrimitiveTriangleIndicesEXT[gid] = uvec3(0);
    }

    BARRIER();
}

#extension GL_ARB_shader_draw_parameters : enable
#extension GL_EXT_multiview : enable

void testAdditionalBuiltins()
{
    int id = gl_DrawIDARB;
    int viewIdx = gl_ViewIndex;

}
