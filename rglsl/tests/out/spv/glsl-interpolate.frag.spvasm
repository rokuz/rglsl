; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 28
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %25 "main" %7 %9 %11
OpExecutionMode %25 OriginUpperLeft
OpDecorate %7 Location 0
OpDecorate %9 Location 1
OpDecorate %9 Flat
OpDecorate %11 Location 0
%2 = OpTypeVoid
%4 = OpTypeFloat 32
%3 = OpTypeVector %4 2
%5 = OpTypeInt 32 1
%6 = OpTypeVector %4 4
%8 = OpTypePointer Input %3
%7 = OpVariable  %8  Input
%10 = OpTypePointer Input %5
%9 = OpVariable  %10  Input
%12 = OpTypePointer Output %6
%11 = OpVariable  %12  Output
%15 = OpTypeFunction %2
%16 = OpConstant  %4  0
%14 = OpFunction  %2  None %15
%13 = OpLabel
OpBranch %17
%17 = OpLabel
%18 = OpLoad  %3  %7
%19 = OpLoad  %5  %9
%20 = OpConvertSToF  %4  %19
%21 = OpCompositeExtract  %4  %18 0
%22 = OpCompositeExtract  %4  %18 1
%23 = OpCompositeConstruct  %6  %21 %22 %16 %20
OpStore %11 %23
OpReturn
OpFunctionEnd
%25 = OpFunction  %2  None %15
%24 = OpLabel
OpBranch %26
%26 = OpLabel
%27 = OpFunctionCall  %2  %14
OpReturn
OpFunctionEnd