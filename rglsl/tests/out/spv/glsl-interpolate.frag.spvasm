; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 23
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %14 "main" %7 %9 %11
OpExecutionMode %14 OriginUpperLeft
OpDecorate %7 Location 0
OpDecorate %9 Location 1
OpDecorate %9 Flat
OpDecorate %11 Location 0
%2 = OpTypeVoid
%4 = OpTypeFloat 32
%3 = OpTypeVector %4 2
%5 = OpTypeInt 32 1
%6 = OpTypeVector %4 4
%8 = OpTypePointer Input %3
%7 = OpVariable  %8  Input
%10 = OpTypePointer Input %5
%9 = OpVariable  %10  Input
%12 = OpTypePointer Output %6
%11 = OpVariable  %12  Output
%15 = OpTypeFunction %2
%16 = OpConstant  %4  0
%14 = OpFunction  %2  None %15
%13 = OpLabel
%17 = OpLoad  %3  %7
%18 = OpLoad  %5  %9
%19 = OpConvertSToF  %4  %18
%20 = OpCompositeExtract  %4  %17 0
%21 = OpCompositeExtract  %4  %17 1
%22 = OpCompositeConstruct  %6  %20 %21 %16 %19
OpStore %11 %22
OpReturn
OpFunctionEnd