%11 = OpVariable  %12  Input
%15 = OpTypePointer Output %4
%14 = OpVariable  %15  Output
%17 = OpTypeFunction %2
%19 = OpTypePointer Function %4
%7 = OpFunction  %3  None %8
%6 = OpLabel
OpReturnValue %9
OpFunctionEnd
%16 = OpFunction  %2  None %17
%10 = OpLabel
%18 = OpVariable  %19  Function
