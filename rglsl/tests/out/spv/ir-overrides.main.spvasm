; SPIR-V
; Version: 1.0
; Generator: rspirv
; Bound: 32
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %21 "main"
OpExecutionMode %21 LocalSize 1 1 1
%2 = OpTypeVoid
%3 = OpTypeBool
%4 = OpTypeFloat 32
%5 = OpTypeInt 32 0
%6 = OpConstantTrue  %3
%7 = OpConstant  %4  2.3
%8 = OpConstant  %4  0
%9 = OpConstantFalse  %3
%10 = OpConstant  %4  1.1
%11 = OpConstant  %4  2
%12 = OpConstant  %4  4.6
%13 = OpConstant  %4  2.718
%14 = OpConstant  %5  0
%15 = OpConstant  %4  10
%16 = OpConstant  %4  11
%18 = OpTypePointer Private %4
%17 = OpVariable  %18  Private %16
%19 = OpVariable  %18  Private
%22 = OpTypeFunction %2
%23 = OpConstant  %4  23
%25 = OpTypePointer Function %4
%27 = OpTypePointer Function %3
%21 = OpFunction  %2  None %22
%20 = OpLabel
%24 = OpVariable  %25  Function %23
%26 = OpVariable  %27  Function
%28 = OpVariable  %25  Function
OpBranch %29
%29 = OpLabel
OpStore %26 %6
%30 = OpLoad  %4  %17
%31 = OpFMul  %4  %30 %15
OpStore %28 %31
OpStore %19 %10
OpReturn
OpFunctionEnd