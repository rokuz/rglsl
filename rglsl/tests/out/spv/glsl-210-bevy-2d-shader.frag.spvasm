; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 24
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %14 "main" %7 %9
OpExecutionMode %14 OriginUpperLeft
OpMemberDecorate %6 0 Offset 0
OpDecorate %7 Location 0
OpDecorate %9 Location 0
OpDecorate %11 DescriptorSet 1
OpDecorate %11 Binding 0
OpDecorate %6 Block
%2 = OpTypeVoid
%4 = OpTypeFloat 32
%3 = OpTypeVector %4 2
%5 = OpTypeVector %4 4
%6 = OpTypeStruct %5
%8 = OpTypePointer Input %3
%7 = OpVariable  %8  Input
%10 = OpTypePointer Output %5
%9 = OpVariable  %10  Output
%12 = OpTypePointer Uniform %6
%11 = OpVariable  %12  Uniform
%15 = OpTypeFunction %2
%17 = OpTypePointer Function %5
%18 = OpTypePointer Uniform %5
%20 = OpTypeInt 32 0
%19 = OpConstant  %20  0
%14 = OpFunction  %2  None %15
%13 = OpLabel
%16 = OpVariable  %17  Function
%21 = OpAccessChain  %18  %11 %19
%22 = OpLoad  %5  %21
OpStore %16 %22
%23 = OpLoad  %5  %16
OpStore %9 %23
OpReturn
OpFunctionEnd