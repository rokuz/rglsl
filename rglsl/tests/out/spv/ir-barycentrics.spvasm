%5 = OpTypeVector %4 4
%8 = OpTypePointer Input %3
%7 = OpVariable  %8  Input
%11 = OpTypePointer Output %5
%10 = OpVariable  %11  Output
%13 = OpTypeFunction %2
%14 = OpConstant  %4  1
%17 = OpVariable  %8  Input
%19 = OpVariable  %11  Output
%12 = OpFunction  %2  None %13
%6 = OpLabel
%9 = OpLoad  %3  %7
%15 = OpCompositeConstruct  %5  %9 %14
OpStore %10 %15
OpReturn
OpFunctionEnd
%20 = OpFunction  %2  None %13
%16 = OpLabel
%18 = OpLoad  %3  %17
%21 = OpCompositeConstruct  %5  %18 %14
OpStore %19 %21
OpReturn
OpFunctionEnd