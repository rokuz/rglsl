; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 40
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %34 "main" %29 %32
OpExecutionMode %34 OriginUpperLeft
OpDecorate %10 DescriptorSet 0
OpDecorate %10 Binding 0
OpDecorate %12 DescriptorSet 0
OpDecorate %12 Binding 1
OpDecorate %29 Location 0
OpDecorate %32 Location 0
%2 = OpTypeVoid
%4 = OpTypeFloat 32
%3 = OpTypeVector %4 2
%5 = OpTypeImage %4 2D 0 0 0 1 Unknown
%6 = OpTypeSampler
%7 = OpTypeVector %4 4
%9 = OpTypePointer Private %3
%8 = OpVariable  %9  Private
%11 = OpTypePointer UniformConstant %5
%10 = OpVariable  %11  UniformConstant
%13 = OpTypePointer UniformConstant %6
%12 = OpVariable  %13  UniformConstant
%15 = OpTypePointer Private %7
%14 = OpVariable  %15  Private
%18 = OpTypeFunction %2
%23 = OpTypeSampledImage %5
%27 = OpTypeInt 32 0
%26 = OpConstant  %27  1
%30 = OpTypePointer Input %3
%29 = OpVariable  %30  Input
%33 = OpTypePointer Output %7
%32 = OpVariable  %33  Output
%17 = OpFunction  %2  None %18
%16 = OpLabel
%19 = OpLoad  %5  %10
%20 = OpLoad  %6  %12
OpBranch %21
%21 = OpLabel
%22 = OpLoad  %3  %8
%24 = OpSampledImage  %23  %19 %20
%25 = OpImageGather  %7  %24 %22 %26
OpStore %14 %25
OpReturn
OpFunctionEnd
%34 = OpFunction  %2  None %18
%28 = OpLabel
%31 = OpLoad  %3  %29
%35 = OpLoad  %5  %10
%36 = OpLoad  %6  %12
OpBranch %37
%37 = OpLabel
OpStore %8 %31
%38 = OpFunctionCall  %2  %17
%39 = OpLoad  %7  %14
OpStore %32 %39
OpReturn
OpFunctionEnd