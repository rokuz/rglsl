%13 = OpTypePointer Function %4
%15 = OpTypeInt 32 0
%14 = OpConstant  %15  0
%6 = OpFunction  %2  None %7
%5 = OpLabel
%11 = OpVariable  %12  Function
OpStore %11 %9
%16 = OpAccessChain  %13  %11 %14
