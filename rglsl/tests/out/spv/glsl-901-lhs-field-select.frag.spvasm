%12 = OpTypePointer Function %3
%14 = OpTypePointer Function %4
%16 = OpTypeInt 32 0
%15 = OpConstant  %16  0
%6 = OpFunction  %2  None %7
%5 = OpLabel
%11 = OpVariable  %12  Function
OpBranch %13
