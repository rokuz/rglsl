; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 32
OpCapability Shader
OpCapability FragmentBarycentricKHR
OpExtension "SPV_KHR_fragment_shader_barycentric"
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %28 "fs_main" %23 %26
OpExecutionMode %28 OriginUpperLeft
OpDecorate %23 Location 0
OpDecorate %23 PerVertexKHR
OpDecorate %26 Location 0
%2 = OpTypeVoid
%3 = OpTypeFloat 32
%6 = OpTypeInt 32 0
%5 = OpConstant  %6  3
%4 = OpTypeArray %3 %5
%7 = OpTypeVector %3 4
%8 = OpConstant  %3  1
%10 = OpTypePointer Private %4
%9 = OpVariable  %10  Private
%12 = OpTypePointer Private %7
%11 = OpVariable  %12  Private
%15 = OpTypeFunction %2
%24 = OpTypePointer Input %4
%23 = OpVariable  %24  Input
%27 = OpTypePointer Output %7
%26 = OpVariable  %27  Output
%14 = OpFunction  %2  None %15
%13 = OpLabel
OpBranch %16
%16 = OpLabel
%17 = OpLoad  %4  %9
%18 = OpCompositeExtract  %3  %17 0
%19 = OpCompositeExtract  %3  %17 1
%20 = OpCompositeExtract  %3  %17 2
%21 = OpCompositeConstruct  %7  %18 %19 %20 %8
OpStore %11 %21
OpReturn
OpFunctionEnd
%28 = OpFunction  %2  None %15
%22 = OpLabel
%25 = OpLoad  %4  %23
OpBranch %29
%29 = OpLabel
OpStore %9 %25
%30 = OpFunctionCall  %2  %14
%31 = OpLoad  %7  %11
OpStore %26 %31
OpReturn
OpFunctionEnd