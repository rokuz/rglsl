%8 = OpConstant  %3  2
%9 = OpConstantComposite  %4  %7 %8
%12 = OpTypeFunction %2
%14 = OpTypePointer Function %4
%15 = OpConstantNull  %4
%11 = OpFunction  %2  None %12
%10 = OpLabel
%13 = OpVariable  %14  Function %15
OpBranch %16
%16 = OpLabel
OpStore %13 %9
OpReturn
OpFunctionEnd