; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 20
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %17 "main"
OpExecutionMode %17 OriginUpperLeft
%2 = OpTypeVoid
%3 = OpTypeFloat 32
%6 = OpTypeInt 32 0
%5 = OpConstant  %6  2
%4 = OpTypeArray %3 %5
%7 = OpConstant  %3  1
%8 = OpConstant  %3  2
%9 = OpConstantComposite  %4  %7 %8
%12 = OpTypeFunction %2
%14 = OpTypePointer Function %4
%11 = OpFunction  %2  None %12
%10 = OpLabel
%13 = OpVariable  %14  Function %9
OpBranch %15
%15 = OpLabel
OpReturn
OpFunctionEnd
%17 = OpFunction  %2  None %12
%16 = OpLabel
OpBranch %18
%18 = OpLabel
%19 = OpFunctionCall  %2  %11
OpReturn
OpFunctionEnd