; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 26
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %16 "compute1" %10 %13
OpExecutionMode %16 LocalSize 1 1 1
OpDecorate %10 BuiltIn LocalInvocationId
OpDecorate %13 BuiltIn LocalInvocationIndex
%2 = OpTypeVoid
%3 = OpTypeInt 32 0
%4 = OpTypeVector %3 3
%5 = OpTypeStruct %4 %3
%7 = OpTypePointer Workgroup %3
%6 = OpVariable  %7  Workgroup
%11 = OpTypePointer Input %4
%10 = OpVariable  %11  Input
%14 = OpTypePointer Input %3
%13 = OpVariable  %14  Input
%17 = OpTypeFunction %2
%18 = OpConstant  %3  2
%16 = OpFunction  %2  None %17
%8 = OpLabel
%12 = OpLoad  %4  %10
%15 = OpLoad  %3  %13
%9 = OpCompositeConstruct  %5  %12 %15
OpBranch %19
%19 = OpLabel
%20 = OpCompositeExtract  %3  %9 1
%21 = OpIMul  %3  %20 %18
OpStore %6 %21
%22 = OpLoad  %3  %6
%23 = OpCompositeExtract  %4  %9 0
%24 = OpCompositeExtract  %3  %23 0
%25 = OpIAdd  %3  %22 %24
OpStore %6 %25
OpReturn
OpFunctionEnd