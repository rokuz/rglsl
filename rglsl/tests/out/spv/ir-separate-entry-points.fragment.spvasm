; SPIR-V
; Version: 1.0
; Generator: rspirv
; Bound: 18
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %15 "fragment" %13
OpExecutionMode %15 OriginUpperLeft
OpDecorate %13 Location 0
%2 = OpTypeVoid
%4 = OpTypeFloat 32
%3 = OpTypeVector %4 4
%7 = OpTypeFunction %2
%8 = OpConstant  %4  0
%14 = OpTypePointer Output %3
%13 = OpVariable  %14  Output
%16 = OpConstantNull  %3
%6 = OpFunction  %2  None %7
%5 = OpLabel
%9 = OpDPdx  %4  %8
%10 = OpDPdy  %4  %8
%11 = OpFwidth  %4  %8
OpReturn
OpFunctionEnd
%15 = OpFunction  %2  None %7
%12 = OpLabel
%17 = OpFunctionCall  %2  %6
OpStore %13 %16
OpReturn
OpFunctionEnd