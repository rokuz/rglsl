; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 16
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %11 "main" %6 %8
OpExecutionMode %11 OriginUpperLeft
OpDecorate %6 Location 0
OpDecorate %8 Location 0
%2 = OpTypeVoid
%4 = OpTypeFloat 32
%3 = OpTypeVector %4 2
%5 = OpTypeVector %4 4
%7 = OpTypePointer Input %3
%6 = OpVariable  %7  Input
%9 = OpTypePointer Output %5
%8 = OpVariable  %9  Output
%12 = OpTypeFunction %2
%13 = OpConstant  %4  1
%14 = OpConstantComposite  %5  %13 %13 %13 %13
%11 = OpFunction  %2  None %12
%10 = OpLabel
OpBranch %15
%15 = OpLabel
OpStore %8 %14
OpReturn
OpFunctionEnd