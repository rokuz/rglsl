; SPIR-V
; Version: 1.0
; Generator: rspirv
; Bound: 30
OpCapability Shader
OpCapability Int64ImageEXT
OpCapability Int64
OpCapability Int64Atomics
OpExtension "SPV_EXT_shader_image_int64"
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %15 "cs_main" %12
OpExecutionMode %15 LocalSize 2 1 1
OpDecorate %9 DescriptorSet 0
OpDecorate %9 Binding 0
OpDecorate %12 BuiltIn LocalInvocationId
%2 = OpTypeVoid
%4 = OpTypeInt 64 0
%3 = OpTypeImage %4 2D 0 0 0 2 R64ui
%6 = OpTypeInt 32 0
%5 = OpTypeVector %6 3
%8 = OpTypeInt 32 1
%7 = OpTypeVector %8 2
%10 = OpTypePointer UniformConstant %3
%9 = OpVariable  %10  UniformConstant
%13 = OpTypePointer Input %5
%12 = OpVariable  %13  Input
%16 = OpTypeFunction %2
%17 = OpConstant  %8  0
%18 = OpConstantComposite  %7  %17 %17
%19 = OpConstant  %4  1
%21 = OpTypePointer Image %4
%23 = OpConstant  %6  0
%25 = OpConstant  %8  1
%26 = OpConstant  %6  2
%27 = OpConstant  %6  264
%15 = OpFunction  %2  None %16
%11 = OpLabel
%14 = OpLoad  %5  %12
OpBranch %20
%20 = OpLabel
%22 = OpImageTexelPointer  %21  %9 %18 %23
%24 = OpAtomicUMax  %4  %22 %25 %23 %19
OpControlBarrier %26 %26 %27
%28 = OpImageTexelPointer  %21  %9 %18 %23
%29 = OpAtomicUMin  %4  %28 %25 %23 %19
OpReturn
OpFunctionEnd