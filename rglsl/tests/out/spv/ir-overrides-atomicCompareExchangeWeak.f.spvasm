; SPIR-V
; Version: 1.0
; Generator: rspirv
; Bound: 19
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %11 "f"
OpExecutionMode %11 LocalSize 1 1 1
%2 = OpTypeVoid
%3 = OpTypeInt 32 1
%4 = OpTypeInt 32 0
%5 = OpTypeBool
%6 = OpTypeStruct %4 %5
%7 = OpConstant  %3  2
%9 = OpTypePointer Workgroup %4
%8 = OpVariable  %9  Workgroup
%12 = OpTypeFunction %2
%13 = OpConstant  %4  2
%14 = OpConstant  %4  1
%16 = OpConstant  %4  0
%11 = OpFunction  %2  None %12
%10 = OpLabel
%17 = OpAtomicCompareExchange  %4  %8 %7 %16 %16 %14 %13
%18 = OpIEqual  %5  %17 %13
%15 = OpCompositeConstruct  %6  %17 %18
OpReturn
OpFunctionEnd