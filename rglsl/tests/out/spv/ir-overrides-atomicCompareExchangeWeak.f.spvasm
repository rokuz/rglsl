; SPIR-V
; Version: 1.0
; Generator: rspirv
; Bound: 20
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %11 "f"
OpExecutionMode %11 LocalSize 1 1 1
%2 = OpTypeVoid
%3 = OpTypeInt 32 1
%4 = OpTypeInt 32 0
%5 = OpTypeBool
%6 = OpTypeStruct %4 %5
%7 = OpConstant  %3  2
%9 = OpTypePointer Workgroup %4
%8 = OpVariable  %9  Workgroup
%12 = OpTypeFunction %2
%13 = OpConstant  %4  2
%14 = OpConstant  %4  1
%17 = OpConstant  %4  0
%11 = OpFunction  %2  None %12
%10 = OpLabel
OpBranch %15
%15 = OpLabel
%18 = OpAtomicCompareExchange  %4  %8 %7 %17 %17 %14 %13
%19 = OpIEqual  %5  %18 %13
%16 = OpCompositeConstruct  %6  %18 %19
OpReturn
OpFunctionEnd