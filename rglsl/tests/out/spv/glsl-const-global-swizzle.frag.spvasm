; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 26
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %14 "main" %9 %11
OpExecutionMode %14 OriginUpperLeft
OpDecorate %9 Location 0
OpDecorate %11 Location 0
%2 = OpTypeVoid
%4 = OpTypeFloat 32
%3 = OpTypeVector %4 2
%5 = OpTypeVector %4 4
%6 = OpConstant  %4  0
%7 = OpConstant  %4  1
%8 = OpConstantComposite  %3  %6 %7
%10 = OpTypePointer Input %3
%9 = OpVariable  %10  Input
%12 = OpTypePointer Output %5
%11 = OpVariable  %12  Output
%15 = OpTypeFunction %2
%17 = OpTypePointer Function %3
%14 = OpFunction  %2  None %15
%13 = OpLabel
%16 = OpVariable  %17  Function
OpBranch %18
%18 = OpLabel
%19 = OpLoad  %3  %9
%20 = OpVectorShuffle  %3  %19 %19 0 1
%21 = OpFMul  %3  %20 %8
OpStore %16 %21
%22 = OpLoad  %3  %16
%23 = OpCompositeExtract  %4  %22 0
%24 = OpCompositeExtract  %4  %22 1
%25 = OpCompositeConstruct  %5  %23 %24 %6 %7
OpStore %11 %25
OpReturn
OpFunctionEnd