; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 31
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %28 "main" %9 %11
OpExecutionMode %28 OriginUpperLeft
OpDecorate %9 Location 0
OpDecorate %11 Location 0
%2 = OpTypeVoid
%4 = OpTypeFloat 32
%3 = OpTypeVector %4 2
%5 = OpTypeVector %4 4
%6 = OpConstant  %4  0
%7 = OpConstant  %4  1
%8 = OpConstantComposite  %3  %6 %7
%10 = OpTypePointer Input %3
%9 = OpVariable  %10  Input
%12 = OpTypePointer Output %5
%11 = OpVariable  %12  Output
%15 = OpTypeFunction %2
%17 = OpTypePointer Function %3
%18 = OpConstantNull  %3
%14 = OpFunction  %2  None %15
%13 = OpLabel
%16 = OpVariable  %17  Function %18
OpBranch %19
%19 = OpLabel
%20 = OpLoad  %3  %9
%21 = OpVectorShuffle  %3  %20 %20 0 1
%22 = OpFMul  %3  %21 %8
OpStore %16 %22
%23 = OpLoad  %3  %16
%24 = OpCompositeExtract  %4  %23 0
%25 = OpCompositeExtract  %4  %23 1
%26 = OpCompositeConstruct  %5  %24 %25 %6 %7
OpStore %11 %26
OpReturn
OpFunctionEnd
%28 = OpFunction  %2  None %15
%27 = OpLabel
OpBranch %29
%29 = OpLabel
%30 = OpFunctionCall  %2  %14
OpReturn
OpFunctionEnd