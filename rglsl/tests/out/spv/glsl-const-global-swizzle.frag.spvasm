; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 25
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %14 "main" %9 %11
OpExecutionMode %14 OriginUpperLeft
OpDecorate %9 Location 0
OpDecorate %11 Location 0
%2 = OpTypeVoid
%4 = OpTypeFloat 32
%3 = OpTypeVector %4 2
%5 = OpTypeVector %4 4
%6 = OpConstant  %4  0
%7 = OpConstant  %4  1
%8 = OpConstantComposite  %3  %6 %7
%10 = OpTypePointer Input %3
%9 = OpVariable  %10  Input
%12 = OpTypePointer Output %5
%11 = OpVariable  %12  Output
%15 = OpTypeFunction %2
%17 = OpTypePointer Function %3
%14 = OpFunction  %2  None %15
%13 = OpLabel
%16 = OpVariable  %17  Function
%18 = OpLoad  %3  %9
%19 = OpVectorShuffle  %3  %18 %18 0 1
%20 = OpFMul  %3  %19 %8
OpStore %16 %20
%21 = OpLoad  %3  %16
%22 = OpCompositeExtract  %4  %21 0
%23 = OpCompositeExtract  %4  %21 1
%24 = OpCompositeConstruct  %5  %22 %23 %6 %7
OpStore %11 %24
OpReturn
OpFunctionEnd