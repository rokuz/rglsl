; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 16
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %9 "main" %5 %7
OpExecutionMode %9 OriginUpperLeft
OpDecorate %5 Location 0
OpDecorate %5 Index 0
OpDecorate %7 Location 0
OpDecorate %7 Index 1
%2 = OpTypeVoid
%4 = OpTypeFloat 32
%3 = OpTypeVector %4 4
%6 = OpTypePointer Output %3
%5 = OpVariable  %6  Output
%7 = OpVariable  %6  Output
%10 = OpTypeFunction %2
%11 = OpConstant  %4  1
%12 = OpConstant  %4  0
%13 = OpConstantComposite  %3  %11 %12 %11 %12
%14 = OpConstantComposite  %3  %12 %11 %12 %11
%9 = OpFunction  %2  None %10
%8 = OpLabel
OpBranch %15
%15 = OpLabel
OpStore %5 %13
OpStore %7 %14
OpReturn
OpFunctionEnd