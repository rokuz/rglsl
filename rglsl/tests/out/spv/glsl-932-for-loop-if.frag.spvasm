; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 24
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %5 "main"
OpExecutionMode %5 OriginUpperLeft
%2 = OpTypeVoid
%3 = OpTypeInt 32 1
%6 = OpTypeFunction %2
%7 = OpConstant  %3  0
%8 = OpConstant  %3  1
%10 = OpTypePointer Function %3
%17 = OpTypeBool
%5 = OpFunction  %2  None %6
%4 = OpLabel
%9 = OpVariable  %10  Function
OpBranch %11
%11 = OpLabel
OpStore %9 %7
OpBranch %12
%12 = OpLabel
OpLoopMerge %13 %15 None
OpBranch %14
%14 = OpLabel
%16 = OpLoad  %3  %9
%18 = OpSLessThan  %17  %16 %8
%19 = OpLogicalNot  %17  %18
OpSelectionMerge %20 None
OpBranchConditional %19 %21 %20
%21 = OpLabel
OpBranch %13
%20 = OpLabel
OpBranch %15
%15 = OpLabel
%22 = OpLoad  %3  %9
%23 = OpIAdd  %3  %22 %8
OpStore %9 %23
OpBranch %12
%13 = OpLabel
OpReturn
OpFunctionEnd