; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 13
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %8 "main" %5
OpExecutionMode %8 OriginUpperLeft
OpDecorate %5 Location 0
%2 = OpTypeVoid
%4 = OpTypeFloat 32
%3 = OpTypeVector %4 4
%6 = OpTypePointer Output %3
%5 = OpVariable  %6  Output
%9 = OpTypeFunction %2
%10 = OpConstant  %4  0
%11 = OpConstantComposite  %3  %10 %10 %10 %10
%8 = OpFunction  %2  None %9
%7 = OpLabel
OpBranch %12
%12 = OpLabel
OpStore %5 %11
OpReturn
OpFunctionEnd