; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 33
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %19 "main" %11 %13 %14 %16
OpDecorate %11 Location 0
OpDecorate %13 Location 1
OpDecorate %14 Location 0
OpDecorate %9 Block
OpMemberDecorate %9 0 BuiltIn Position
OpMemberDecorate %9 1 BuiltIn PointSize
OpMemberDecorate %9 2 BuiltIn ClipDistance
OpMemberDecorate %9 3 BuiltIn CullDistance
%2 = OpTypeVoid
%3 = OpTypeFloat 32
%4 = OpTypeVector %3 2
%5 = OpTypeVector %3 4
%8 = OpTypeInt 32 0
%7 = OpConstant  %8  1
%6 = OpTypeArray %3 %7
%9 = OpTypeStruct %5 %3 %6 %6
%10 = OpConstant  %3  1.2
%12 = OpTypePointer Input %4
%11 = OpVariable  %12  Input
%13 = OpVariable  %12  Input
%15 = OpTypePointer Output %4
%14 = OpVariable  %15  Output
%17 = OpTypePointer Output %9
%16 = OpVariable  %17  Output
%20 = OpTypeFunction %2
%21 = OpConstant  %3  0
%22 = OpConstant  %3  1
%25 = OpTypePointer Output %5
%31 = OpConstant  %8  0
%19 = OpFunction  %2  None %20
%18 = OpLabel
OpBranch %23
%23 = OpLabel
%24 = OpLoad  %4  %13
OpStore %14 %24
%26 = OpLoad  %4  %11
%27 = OpVectorTimesScalar  %4  %26 %10
%28 = OpCompositeExtract  %3  %27 0
%29 = OpCompositeExtract  %3  %27 1
%30 = OpCompositeConstruct  %5  %28 %29 %21 %22
%32 = OpAccessChain  %25  %16 %31
OpStore %32 %30
OpReturn
OpFunctionEnd