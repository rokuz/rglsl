; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 32
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %19 "main" %11 %13 %14 %16
OpDecorate %11 Location 0
OpDecorate %13 Location 1
OpDecorate %14 Location 0
OpDecorate %9 Block
OpMemberDecorate %9 0 BuiltIn Position
OpMemberDecorate %9 1 BuiltIn PointSize
OpMemberDecorate %9 2 BuiltIn ClipDistance
OpMemberDecorate %9 3 BuiltIn CullDistance
%2 = OpTypeVoid
%3 = OpTypeFloat 32
%4 = OpTypeVector %3 2
%5 = OpTypeVector %3 4
%8 = OpTypeInt 32 0
%7 = OpConstant  %8  1
%6 = OpTypeArray %3 %7
%9 = OpTypeStruct %5 %3 %6 %6
%10 = OpConstant  %3  1.2
%12 = OpTypePointer Input %4
%11 = OpVariable  %12  Input
%13 = OpVariable  %12  Input
%15 = OpTypePointer Output %4
%14 = OpVariable  %15  Output
%17 = OpTypePointer Output %9
%16 = OpVariable  %17  Output
%20 = OpTypeFunction %2
%21 = OpConstant  %3  0
%22 = OpConstant  %3  1
%24 = OpTypePointer Output %5
%30 = OpConstant  %8  0
%19 = OpFunction  %2  None %20
%18 = OpLabel
%23 = OpLoad  %4  %13
OpStore %14 %23
%25 = OpLoad  %4  %11
%26 = OpVectorTimesScalar  %4  %25 %10
%27 = OpCompositeExtract  %3  %26 0
%28 = OpCompositeExtract  %3  %26 1
%29 = OpCompositeConstruct  %5  %27 %28 %21 %22
%31 = OpAccessChain  %24  %16 %30
OpStore %31 %29
OpReturn
OpFunctionEnd