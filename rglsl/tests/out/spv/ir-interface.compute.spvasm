%5 = OpTypeStruct %4 %3
%6 = OpTypeInt 32 0
%7 = OpTypeStruct %3 %6 %3
%8 = OpTypeBool
%10 = OpConstant  %6  1
%9 = OpTypeArray %6 %10
%11 = OpTypeVector %6 3
%12 = OpTypeStruct %6
%13 = OpTypeStruct %6
%15 = OpTypePointer Workgroup %9
%14 = OpVariable  %15  Workgroup
%18 = OpTypePointer Input %11
%17 = OpVariable  %18  Input
%20 = OpVariable  %18  Input
%23 = OpTypePointer Input %6
%22 = OpVariable  %23  Input
%25 = OpVariable  %18  Input
%27 = OpVariable  %18  Input
%30 = OpTypeFunction %2
%32 = OpTypePointer Workgroup %6
%41 = OpConstant  %6  0
%29 = OpFunction  %2  None %30
%16 = OpLabel
%19 = OpLoad  %11  %17
%21 = OpLoad  %11  %20
%24 = OpLoad  %6  %22
%26 = OpLoad  %11  %25
%28 = OpLoad  %11  %27
OpBranch %31
%31 = OpLabel
%33 = OpCompositeExtract  %6  %19 0
%34 = OpCompositeExtract  %6  %21 0
%35 = OpIAdd  %6  %33 %34
%36 = OpIAdd  %6  %35 %24
%37 = OpCompositeExtract  %6  %26 0
%38 = OpIAdd  %6  %36 %37
%39 = OpCompositeExtract  %6  %28 0
%40 = OpIAdd  %6  %38 %39
%42 = OpAccessChain  %32  %14 %41
OpStore %42 %40
OpReturn
OpFunctionEnd