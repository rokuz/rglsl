; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 56
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %26 "main" %17 %19 %21 %23
OpMemberDecorate %6 0 Offset 0
OpMemberDecorate %6 0 ColMajor
OpMemberDecorate %6 0 MatrixStride 16
