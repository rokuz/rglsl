%19 = OpTypePointer Workgroup %4
%20 = OpConstant  %3  2
%21 = OpConstant  %3  264
%24 = OpTypeBool
%14 = OpFunction  %2  None %15
%10 = OpLabel
%13 = OpLoad  %7  %11
OpBranch %17
%17 = OpLabel
%18 = OpCompositeExtract  %3  %13 0
OpControlBarrier %20 %20 %21
%22 = OpAccessChain  %19  %8 %18
%23 = OpLoad  %4  %22
