; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 29
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %21 "main" %18 %20
OpExecutionMode %21 OriginUpperLeft
OpDecorate %18 Location 0
OpDecorate %18 Index 0
OpDecorate %20 Location 0
OpDecorate %20 Index 1
%2 = OpTypeVoid
%3 = OpTypeFloat 32
%4 = OpTypeVector %3 4
%5 = OpTypeStruct %4 %4
%6 = OpConstant  %3  1
%7 = OpConstant  %3  0
%8 = OpConstantComposite  %4  %6 %7 %6 %7
%9 = OpConstantComposite  %4  %7 %6 %7 %6
%11 = OpTypePointer Private %4
%10 = OpVariable  %11  Private
%12 = OpVariable  %11  Private
%15 = OpTypeFunction %2
%19 = OpTypePointer Output %4
%18 = OpVariable  %19  Output
%20 = OpVariable  %19  Output
%14 = OpFunction  %2  None %15
%13 = OpLabel
OpBranch %16
%16 = OpLabel
OpStore %10 %8
OpStore %12 %9
OpReturn
OpFunctionEnd
%21 = OpFunction  %2  None %15
%17 = OpLabel
OpBranch %22
%22 = OpLabel
%23 = OpFunctionCall  %2  %14
%24 = OpLoad  %4  %10
%25 = OpLoad  %4  %12
%26 = OpCompositeConstruct  %5  %24 %25
%27 = OpCompositeExtract  %4  %26 0
OpStore %18 %27
%28 = OpCompositeExtract  %4  %26 1
OpStore %20 %28
OpReturn
OpFunctionEnd