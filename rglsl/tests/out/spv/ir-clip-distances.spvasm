OpEntryPoint Vertex %14 "main" %10 %12
OpDecorate %10 BuiltIn Position
OpDecorate %12 BuiltIn ClipDistance
%2 = OpTypeVoid
%3 = OpTypeFloat 32
%4 = OpTypeVector %3 4
%7 = OpTypeInt 32 0
