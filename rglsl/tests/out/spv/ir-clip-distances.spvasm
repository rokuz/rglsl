%13 = OpTypePointer Output %5
%12 = OpVariable  %13  Output
%15 = OpTypeFunction %2
%16 = OpConstant  %3  0.5
%18 = OpTypePointer Function %8
%20 = OpTypePointer Function %5
%21 = OpTypePointer Function %3
%22 = OpConstant  %7  0
%14 = OpFunction  %2  None %15
%9 = OpLabel
%17 = OpVariable  %18  Function
OpBranch %19
%19 = OpLabel
%23 = OpAccessChain  %21  %17 %6 %22
OpStore %23 %16
%24 = OpLoad  %8  %17
%25 = OpCompositeExtract  %4  %24 0
OpStore %10 %25
%26 = OpCompositeExtract  %5  %24 1
OpStore %12 %26
