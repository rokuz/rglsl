; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 30
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %15 "main" %10 %12
OpDecorate %10 Location 0
OpDecorate %9 Block
OpMemberDecorate %9 0 BuiltIn Position
OpMemberDecorate %9 1 BuiltIn PointSize
OpMemberDecorate %9 2 BuiltIn ClipDistance
OpMemberDecorate %9 3 BuiltIn CullDistance
%2 = OpTypeVoid
%4 = OpTypeFloat 32
%3 = OpTypeVector %4 2
%5 = OpTypeVector %4 4
%8 = OpTypeInt 32 0
%7 = OpConstant  %8  1
%6 = OpTypeArray %4 %7
%9 = OpTypeStruct %5 %4 %6 %6
%11 = OpTypePointer Input %3
%10 = OpVariable  %11  Input
%13 = OpTypePointer Output %9
%12 = OpVariable  %13  Output
%16 = OpTypeFunction %2
%17 = OpConstant  %4  0
%18 = OpConstant  %4  1
%19 = OpConstantComposite  %3  %17 %17
%20 = OpConstantComposite  %3  %18 %18
%22 = OpTypePointer Output %5
%28 = OpConstant  %8  0
%15 = OpFunction  %2  None %16
%14 = OpLabel
OpBranch %21
%21 = OpLabel
%23 = OpLoad  %3  %10
%24 = OpExtInst  %3  %1 FClamp %23 %19 %20
%25 = OpCompositeExtract  %4  %24 0
%26 = OpCompositeExtract  %4  %24 1
%27 = OpCompositeConstruct  %5  %25 %26 %17 %18
%29 = OpAccessChain  %22  %12 %28
OpStore %29 %27
OpReturn
OpFunctionEnd