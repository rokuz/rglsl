; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 34
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %28 "main" %26 %7
OpDecorate %7 Location 0
OpDecorate %26 BuiltIn Position
%2 = OpTypeVoid
