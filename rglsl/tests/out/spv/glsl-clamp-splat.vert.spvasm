; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 29
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %15 "main" %10 %12
OpDecorate %10 Location 0
OpDecorate %9 Block
OpMemberDecorate %9 0 BuiltIn Position
OpMemberDecorate %9 1 BuiltIn PointSize
OpMemberDecorate %9 2 BuiltIn ClipDistance
OpMemberDecorate %9 3 BuiltIn CullDistance
%2 = OpTypeVoid
%4 = OpTypeFloat 32
%3 = OpTypeVector %4 2
%5 = OpTypeVector %4 4
%8 = OpTypeInt 32 0
%7 = OpConstant  %8  1
%6 = OpTypeArray %4 %7
%9 = OpTypeStruct %5 %4 %6 %6
%11 = OpTypePointer Input %3
%10 = OpVariable  %11  Input
%13 = OpTypePointer Output %9
%12 = OpVariable  %13  Output
%16 = OpTypeFunction %2
%17 = OpConstant  %4  0
%18 = OpConstant  %4  1
%19 = OpConstantComposite  %3  %17 %17
%20 = OpConstantComposite  %3  %18 %18
%21 = OpTypePointer Output %5
%27 = OpConstant  %8  0
%15 = OpFunction  %2  None %16
%14 = OpLabel
%22 = OpLoad  %3  %10
%23 = OpExtInst  %3  %1 FClamp %22 %19 %20
%24 = OpCompositeExtract  %4  %23 0
%25 = OpCompositeExtract  %4  %23 1
%26 = OpCompositeConstruct  %5  %24 %25 %17 %18
%28 = OpAccessChain  %21  %12 %27
OpStore %28 %26
OpReturn
OpFunctionEnd