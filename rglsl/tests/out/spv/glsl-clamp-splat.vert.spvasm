%3 = OpTypeVector %4 2
%5 = OpTypeVector %4 4
%6 = OpTypeStruct %5
%8 = OpTypePointer Input %3
%7 = OpVariable  %8  Input
%10 = OpTypePointer Private %5
%11 = OpConstantNull  %5
%9 = OpVariable  %10  Private %11
%14 = OpTypeFunction %2
%15 = OpConstant  %4  0
%16 = OpConstant  %4  1
%17 = OpConstantComposite  %3  %15 %15
%18 = OpConstantComposite  %3  %16 %16
%27 = OpTypePointer Output %5
%26 = OpVariable  %27  Output
%13 = OpFunction  %2  None %14
%12 = OpLabel
OpBranch %19
%19 = OpLabel
%20 = OpLoad  %3  %7
%21 = OpExtInst  %3  %1 FClamp %20 %17 %18
%22 = OpCompositeExtract  %4  %21 0
%23 = OpCompositeExtract  %4  %21 1
%24 = OpCompositeConstruct  %5  %22 %23 %15 %16
OpStore %9 %24
OpReturn
OpFunctionEnd
%28 = OpFunction  %2  None %14
%25 = OpLabel
OpBranch %29
%29 = OpLabel
%30 = OpFunctionCall  %2  %13
%31 = OpLoad  %5  %9
%32 = OpCompositeConstruct  %6  %31
%33 = OpCompositeExtract  %5  %32 0
OpStore %26 %33
OpReturn
OpFunctionEnd