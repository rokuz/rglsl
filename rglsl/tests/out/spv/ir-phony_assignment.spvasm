; SPIR-V
; Version: 1.1
; Generator: rspirv
; Bound: 28
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %18 "main" %15
OpExecutionMode %18 LocalSize 1 1 1
OpDecorate %7 DescriptorSet 0
OpDecorate %7 Binding 0
OpDecorate %8 Block
OpMemberDecorate %8 0 Offset 0
OpDecorate %15 BuiltIn GlobalInvocationId
%2 = OpTypeVoid
%3 = OpTypeFloat 32
%4 = OpTypeInt 32 1
%6 = OpTypeInt 32 0
%5 = OpTypeVector %6 3
%8 = OpTypeStruct %3
%9 = OpTypePointer Uniform %8
%7 = OpVariable  %9  Uniform
%12 = OpTypeFunction %4
%13 = OpConstant  %4  5
%16 = OpTypePointer Input %5
%15 = OpVariable  %16  Input
%19 = OpTypeFunction %2
%20 = OpTypePointer Uniform %3
%21 = OpConstant  %6  0
%11 = OpFunction  %4  None %12
%10 = OpLabel
OpReturnValue %13
OpFunctionEnd
%18 = OpFunction  %2  None %19
%14 = OpLabel
%17 = OpLoad  %5  %15
%22 = OpAccessChain  %20  %7 %21
%23 = OpLoad  %3  %22
%24 = OpLoad  %3  %22
%25 = OpFunctionCall  %4  %11
%26 = OpFunctionCall  %4  %11
%27 = OpLoad  %3  %22
OpReturn
OpFunctionEnd