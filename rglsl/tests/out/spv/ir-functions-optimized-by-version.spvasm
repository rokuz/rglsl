; SPIR-V
; Version: 1.6
; Generator: rspirv
; Bound: 28
OpCapability Shader
OpCapability DotProduct
OpCapability DotProductInput4x8BitPacked
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %25 "main"
OpExecutionMode %25 LocalSize 1 1 1
%2 = OpTypeVoid
%3 = OpTypeInt 32 0
%6 = OpTypeFunction %3
%7 = OpConstant  %3  1
%8 = OpConstant  %3  2
%9 = OpConstant  %3  3
%10 = OpConstant  %3  4
%11 = OpConstant  %3  5
%12 = OpConstant  %3  6
%13 = OpConstant  %3  7
%14 = OpConstant  %3  8
%15 = OpTypeInt 32 1
%26 = OpTypeFunction %2
%5 = OpFunction  %3  None %6
%4 = OpLabel
%16 = OpSDot  %15  %7 %8 PackedVectorFormat4x8Bit
%17 = OpUDot  %3  %9 %10 PackedVectorFormat4x8Bit
%18 = OpIAdd  %3  %11 %17
%19 = OpIAdd  %3  %12 %17
%20 = OpSDot  %15  %18 %19 PackedVectorFormat4x8Bit
%21 = OpIAdd  %3  %13 %17
%22 = OpIAdd  %3  %14 %17
%23 = OpUDot  %3  %21 %22 PackedVectorFormat4x8Bit
OpReturnValue %23
OpFunctionEnd
%25 = OpFunction  %2  None %26
%24 = OpLabel
%27 = OpFunctionCall  %3  %5
OpReturn
OpFunctionEnd