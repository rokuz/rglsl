; SPIR-V
; Version: 1.3
; Generator: rspirv
; Bound: 60
OpCapability Shader
OpCapability GroupNonUniform
OpCapability GroupNonUniformBallot
OpCapability GroupNonUniformVote
OpCapability GroupNonUniformArithmetic
OpCapability GroupNonUniformShuffle
OpCapability GroupNonUniformShuffleRelative
OpCapability GroupNonUniformQuad
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %17 "main" %8 %11 %13 %15
OpExecutionMode %17 LocalSize 1 1 1
OpDecorate %8 BuiltIn NumSubgroups
OpDecorate %11 BuiltIn SubgroupSize
OpDecorate %13 BuiltIn SubgroupId
OpDecorate %15 BuiltIn SubgroupLocalInvocationId
%2 = OpTypeVoid
%3 = OpTypeInt 32 0
%4 = OpTypeStruct %3 %3
%5 = OpTypeBool
%9 = OpTypePointer Input %3
%8 = OpVariable  %9  Input
%11 = OpVariable  %9  Input
%13 = OpVariable  %9  Input
%15 = OpVariable  %9  Input
%18 = OpTypeFunction %2
%19 = OpConstant  %3  1
%20 = OpConstant  %3  0
%21 = OpConstant  %3  4
%24 = OpTypeVector %3 4
%26 = OpConstant  %3  3
%27 = OpConstantTrue  %5
%58 = OpConstant  %3  2
%17 = OpFunction  %2  None %18
%6 = OpLabel
%10 = OpLoad  %3  %8
%12 = OpLoad  %3  %11
%7 = OpCompositeConstruct  %4  %10 %12
%14 = OpLoad  %3  %13
%16 = OpLoad  %3  %15
%22 = OpBitwiseAnd  %3  %16 %19
%23 = OpIEqual  %5  %22 %19
%25 = OpGroupNonUniformBallot  %24  %26 %23
%28 = OpGroupNonUniformBallot  %24  %26 %27
%29 = OpINotEqual  %5  %16 %20
%30 = OpGroupNonUniformAll  %5  %26 %29
%31 = OpIEqual  %5  %16 %20
%32 = OpGroupNonUniformAny  %5  %26 %31
%33 = OpGroupNonUniformIAdd  %3  %26 Reduce %16
%34 = OpGroupNonUniformIMul  %3  %26 Reduce %16
%35 = OpGroupNonUniformUMin  %3  %26 Reduce %16
%36 = OpGroupNonUniformUMax  %3  %26 Reduce %16
%37 = OpGroupNonUniformBitwiseAnd  %3  %26 Reduce %16
%38 = OpGroupNonUniformBitwiseOr  %3  %26 Reduce %16
%39 = OpGroupNonUniformBitwiseXor  %3  %26 Reduce %16
%40 = OpGroupNonUniformIAdd  %3  %26 ExclusiveScan %16
%41 = OpGroupNonUniformIMul  %3  %26 ExclusiveScan %16
%42 = OpGroupNonUniformIAdd  %3  %26 InclusiveScan %16
%43 = OpGroupNonUniformIMul  %3  %26 InclusiveScan %16
%44 = OpGroupNonUniformBroadcastFirst  %3  %26 %16
%45 = OpGroupNonUniformBroadcast  %3  %26 %16 %21
%46 = OpCompositeExtract  %3  %7 1
%47 = OpISub  %3  %46 %19
%48 = OpISub  %3  %47 %16
%49 = OpGroupNonUniformShuffle  %3  %26 %16 %48
%50 = OpGroupNonUniformShuffleDown  %3  %26 %16 %19
%51 = OpGroupNonUniformShuffleUp  %3  %26 %16 %19
%52 = OpCompositeExtract  %3  %7 1
%53 = OpISub  %3  %52 %19
%54 = OpGroupNonUniformShuffleXor  %3  %26 %16 %53
%55 = OpGroupNonUniformQuadBroadcast  %3  %26 %16 %21
%56 = OpGroupNonUniformQuadSwap  %3  %26 %16 %20
%57 = OpGroupNonUniformQuadSwap  %3  %26 %16 %19
%59 = OpGroupNonUniformQuadSwap  %3  %26 %16 %58
OpReturn
OpFunctionEnd