#version 450

layout(local_size_x = 8, local_size_y = 4) in;

layout(binding = 0, std430) buffer Data {
    uint count;
    float values[];
} data;

layout(binding = 1) uniform Params {
    float factor;
    vec2 range;
} params;

float helper(float x);
float unused_helper(float x);

void main()
{
    uint index = gl_GlobalInvocationID.x;
    data.values[index] = helper(data.values[index]) * params.factor;
}
