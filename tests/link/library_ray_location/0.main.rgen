#version 460
#extension GL_EXT_ray_tracing : require
void trace(vec3 origin, vec3 direction, const int payload);
void shadow(vec3 origin, const int payload);
void call(uint record, const int data);
const int VISIBILITY = 1;
layout(location = 0) rayPayloadEXT vec3 color;
layout(location = 1) rayPayloadEXT float visibility;
layout(location = 2) callableDataEXT vec4 parameters;
layout(set = 0, binding = 1) buffer Result { vec4 values[16]; } result;
void main() {
    vec3 origin = vec3(vec2(gl_LaunchIDEXT.xy) / vec2(gl_LaunchSizeEXT.xy), -1.0);
    color = vec3(0.25, 0.5, 0.75);
    visibility = 0.125;
    parameters = vec4(1.0, 2.0, 3.0, 4.0);
    trace(origin, vec3(0.0, 0.0, 1.0), 0);
    if (color.x >= 0.0) {
        shadow(origin, VISIBILITY);
    }
    call(0u, 2);
    uint index = (gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x) % 16u;
    result.values[index] = vec4(color.xy, visibility, parameters.w);
}
