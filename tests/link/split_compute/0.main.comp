#version 450
layout(local_size_x = 8) in;

layout(set = 0, binding = 1) buffer Destination {
    float values[];
} dst;

float scale(float x);
float neighbour(uint index);
uint mix_bits(uint a, uint b);

void main()
{
    uint index = gl_GlobalInvocationID.x;
    dst.values[index] = scale(neighbour(index)) + float(mix_bits(index, 3u));
}
