#version 450
layout(local_size_x = 8) in;

layout(set = 0, binding = 0) readonly buffer Source {
    float values[];
} src;

layout(set = 0, binding = 1) buffer Destination {
    float values[];
} dst;

float scale(float x)
{
    return x * 2.0 + 0.5;
}

uint mix_bits(uint a, uint b)
{
    return (a ^ b) & 7u;
}

float neighbour(uint index)
{
    return src.values[(index + 1u) % 8u];
}

void main()
{
    uint index = gl_GlobalInvocationID.x;
    dst.values[index] = scale(neighbour(index)) + float(mix_bits(index, 3u));
}
