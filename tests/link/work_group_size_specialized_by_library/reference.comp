#version 450
layout(local_size_x = 4, local_size_x_id = 3) in;
layout(set = 0, binding = 0) buffer Data {
    uint values[];
} data;
uint twice(uint x)
{
    return x * 2u;
}
void main()
{
    uint size = gl_WorkGroupSize.x * gl_WorkGroupSize.y;
    data.values[gl_GlobalInvocationID.x] = twice(gl_GlobalInvocationID.x) + size;
}
