#!amber
SHADER compute main SPIRV-BIN FILE main.spv
TENSOR ts0 DATA_TYPE float DIMS 4 DATA 1 2 3 4 END
TENSOR ts1 DATA_TYPE float DIMS 5 DATA 10 11 12 13 14 END
TENSOR ts2 DATA_TYPE float DIMS 6 DATA 100 101 102 103 104 105 END
TENSOR uni DATA_TYPE float DIMS 8 FILL -1.0
TENSOR non DATA_TYPE float DIMS 8 FILL -1.0
TENSOR split0 DATA_TYPE float DIMS 8 FILL -1.0
TENSOR split1 DATA_TYPE float DIMS 8 FILL -1.0
BUFFER params DATA_TYPE uint32 DATA 1 0 0 0 0 END
PIPELINE compute p
  ATTACH main
  BIND BUFFER_ARRAY ts0 ts1 ts2 AS tensor DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER uni AS tensor DESCRIPTOR_SET 0 BINDING 1
  BIND BUFFER non AS tensor DESCRIPTOR_SET 0 BINDING 2
  BIND BUFFER_ARRAY split0 split1 AS tensor DESCRIPTOR_SET 0 BINDING 3
  BIND BUFFER params AS storage DESCRIPTOR_SET 0 BINDING 4
END
RUN p 1 1 1
EXPECT uni IDX 0 EQ 10 11 12 13 14 0 0 0
EXPECT non IDX 0 EQ 1 10 100 2 11 101 3 12
EXPECT split0 IDX 0 EQ 0.5 -1 2.5 -1 4.5 -1 6.5 -1
EXPECT split1 IDX 0 EQ -1 1.5 -1 3.5 -1 5.5 -1 7.5
EXPECT params IDX 0 EQ 1 4 5 6 1121058816
