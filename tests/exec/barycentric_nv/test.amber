#!amber
SHADER vertex vert SPIRV-BIN FILE vert.spv
SHADER fragment frag SPIRV-BIN FILE frag.spv
BUFFER positions DATA_TYPE vec2<float> DATA
  -1.0 -1.0
   3.0 -1.0
  -1.0  3.0
END
BUFFER fb FORMAT R8G8B8A8_UNORM
PIPELINE graphics p
  ATTACH vert
  ATTACH frag
  VERTEX_DATA positions LOCATION 0
  FRAMEBUFFER_SIZE 16 16
  BIND BUFFER fb AS color LOCATION 0
END
CLEAR_COLOR p 0 0 0 0
CLEAR p
RUN p DRAW_ARRAY AS TRIANGLE_LIST START_IDX 0 COUNT 3
EXPECT fb IDX 0 0 SIZE 16 16 EQ_RGBA 7 255 255 255
