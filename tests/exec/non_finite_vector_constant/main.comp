#version 450
layout(local_size_x = 1) in;

layout(std430, set = 0, binding = 0) buffer Data {
    vec2 position;
    float time;
    float unused;
    vec4 result;
};

void main() {
    vec2 square = exp2(vec2(7.6, 400.863)) + vec2(time, 1.0);
    vec3 shade = vec3(0.25);
    if (!(position.y > square.y)) {
        shade = vec3(1.0);
    } else if (1.0 < square.x) {
        shade = vec3(0.5, 1.0, 1.0);
    }
    result = vec4(shade, 2.0);
}
