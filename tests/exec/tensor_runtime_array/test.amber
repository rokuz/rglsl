#!amber
SHADER compute main SPIRV-BIN FILE main.spv
TENSOR ts0 DATA_TYPE int32 DIMS 2 DATA 1 2 END
TENSOR ts1 DATA_TYPE int32 DIMS 3 DATA 10 20 30 END
TENSOR ts2 DATA_TYPE int32 DIMS 2 DATA 100 200 END
TENSOR ts3 DATA_TYPE int32 DIMS 4 DATA 1000 2000 3000 4000 END
BUFFER r DATA_TYPE int32 SIZE 8 FILL 0
PIPELINE compute p
  ATTACH main
  BIND BUFFER_ARRAY ts0 ts1 ts2 ts3 AS tensor DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER r AS storage DESCRIPTOR_SET 0 BINDING 1
END
RUN p 1 1 1
EXPECT r IDX 0 EQ 3 13 102 1004 4 23 202 2004
