    tensorWriteARM(o6, c, v * 3 + 6);
  }
}

void main() {
  uint i = gl_LocalInvocationID.x;
  copy1(i);
  copy2(i);
  copy3(i);
  copy4(i);
  copy5(i);
  copy6(i);
  if (i == 0u) {
    sizes[0] = tensorSizeARM(i1, 0);
    sizes[1] = tensorSizeARM(i2, 0);
    sizes[2] = tensorSizeARM(i2, 1);
    sizes[3] = tensorSizeARM(i3, 0);
    sizes[4] = tensorSizeARM(i3, 1);
    sizes[5] = tensorSizeARM(i3, 2);
    sizes[6] = tensorSizeARM(i4, 0);
    sizes[7] = tensorSizeARM(i4, 1);
    sizes[8] = tensorSizeARM(i4, 2);
    sizes[9] = tensorSizeARM(i4, 3);
    sizes[10] = tensorSizeARM(i5, 0);
    sizes[11] = tensorSizeARM(i5, 1);
    sizes[12] = tensorSizeARM(i5, 2);
    sizes[13] = tensorSizeARM(i5, 3);
    sizes[14] = tensorSizeARM(i5, 4);
    sizes[15] = tensorSizeARM(i6, 0);
    sizes[16] = tensorSizeARM(i6, 1);
    sizes[17] = tensorSizeARM(i6, 2);
    sizes[18] = tensorSizeARM(i6, 3);
    sizes[19] = tensorSizeARM(i6, 4);
    sizes[20] = tensorSizeARM(i6, 5);
  }
}
