#version 450
layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 0) buffer Inputs { float values[4]; int keys[4]; };
layout(std430, set = 0, binding = 1) buffer Results { float results[]; };

float early(float x) {
  if (x < 0.0) return 0.0;
  float y = x * 2.0;
  return y + 1.0;
}

float looped(float x) {
  for (int i = 0; i < 4; i++) {
    if (abs(x) > 10.0) return abs(x);
    x *= 2.0;
  }
  return -x;
}

float nested(float limit) {
  float s = 0.0;
  for (int i = 1; i < 20; i++) {
    s += 1.0;
    do {
      if (float(i) >= limit) return s;
    } while (false);
  }
  return -1.0;
}

float switched(int k) {
  switch (k) {
    case 0: return 1.0;
    case 1: break;
    default: if (k > 5) return 3.0;
  }
  return 2.0;
}

void out_param(out float a, inout float b) {
  a = 1.0;
  b += a;
}

float counted(float x) {
  float t = 1.0;
  t += x;
  return t;
}

void main() {
  results[0] = early(values[0]);
  results[1] = early(values[1]);
  results[2] = looped(values[2]);
  results[3] = looped(values[0]);
  results[4] = nested(values[3]);
  results[5] = nested(values[3] * 25.0);
  results[6] = switched(keys[0]);
  results[7] = switched(keys[1]);
  results[8] = switched(keys[2]);
  results[9] = switched(keys[3]);
  float a;
  float b = 2.0;
  out_param(a, b);
  results[10] = a + b;
  float sum = 0.0;
  for (int i = 0; i < 3; i++) sum += counted(float(i));
  results[11] = sum;
}
