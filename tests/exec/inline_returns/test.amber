#!amber
SHADER compute main SPIRV-BIN FILE main.spv
BUFFER inputs DATA_TYPE uint32 DATA 3212836864 1077936128 1069547520 1082130432 0 1 7 3 END
BUFFER results DATA_TYPE float SIZE 12 FILL 0.0
PIPELINE compute p
  ATTACH main
  BIND BUFFER inputs AS storage DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER results AS storage DESCRIPTOR_SET 0 BINDING 1
END
RUN p 1 1 1
EXPECT results IDX 0 EQ 0.0 7.0 12.0 16.0 4.0 -1.0 1.0 2.0 3.0 2.0 4.0 6.0
