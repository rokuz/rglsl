#!amber
SHADER compute main SPIRV-BIN FILE main.spv
TENSOR in0 DATA_TYPE int8 DIMS 8 DATA -128 -5 0 7 127 -1 33 -100 END
TENSOR out0 DATA_TYPE int8 DIMS 8 FILL 0
TENSOR pairs0 DATA_TYPE int8 DIMS 4 2 DATA -128 -5 0 7 127 -1 33 -100 END
TENSOR in1 DATA_TYPE uint8 DIMS 8 DATA 0 1 200 255 17 128 64 9 END
TENSOR out1 DATA_TYPE uint8 DIMS 8 FILL 0
TENSOR pairs1 DATA_TYPE uint8 DIMS 4 2 DATA 0 1 200 255 17 128 64 9 END
TENSOR in2 DATA_TYPE int16 DIMS 8 DATA -32768 -300 0 300 32767 -2 1234 -999 END
TENSOR out2 DATA_TYPE int16 DIMS 8 FILL 0
TENSOR pairs2 DATA_TYPE int16 DIMS 4 2 DATA -32768 -300 0 300 32767 -2 1234 -999 END
TENSOR in3 DATA_TYPE uint16 DIMS 8 DATA 0 65535 1000 3 40000 7 256 12345 END
TENSOR out3 DATA_TYPE uint16 DIMS 8 FILL 0
TENSOR pairs3 DATA_TYPE uint16 DIMS 4 2 DATA 0 65535 1000 3 40000 7 256 12345 END
PIPELINE compute p
  ATTACH main
  BIND BUFFER in0 AS tensor DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER out0 AS tensor DESCRIPTOR_SET 0 BINDING 1
  BIND BUFFER pairs0 AS tensor DESCRIPTOR_SET 0 BINDING 2
  BIND BUFFER in1 AS tensor DESCRIPTOR_SET 0 BINDING 3
  BIND BUFFER out1 AS tensor DESCRIPTOR_SET 0 BINDING 4
  BIND BUFFER pairs1 AS tensor DESCRIPTOR_SET 0 BINDING 5
  BIND BUFFER in2 AS tensor DESCRIPTOR_SET 0 BINDING 6
  BIND BUFFER out2 AS tensor DESCRIPTOR_SET 0 BINDING 7
  BIND BUFFER pairs2 AS tensor DESCRIPTOR_SET 0 BINDING 8
  BIND BUFFER in3 AS tensor DESCRIPTOR_SET 0 BINDING 9
  BIND BUFFER out3 AS tensor DESCRIPTOR_SET 0 BINDING 10
  BIND BUFFER pairs3 AS tensor DESCRIPTOR_SET 0 BINDING 11
END
RUN p 1 1 1
EXPECT out0 IDX 0 EQ -123 -10 5 26 -126 2 104 -39
EXPECT pairs0 IDX 0 EQ -5 -128 7 0 -1 127 -100 33
EXPECT out1 IDX 0 EQ 5 8 93 2 56 133 197 32
EXPECT pairs1 IDX 0 EQ 1 0 255 200 128 17 9 64
EXPECT out2 IDX 0 EQ -32763 -895 5 905 -32766 -1 3707 -2992
EXPECT pairs2 IDX 0 EQ -300 -32768 300 0 -2 32767 -999 1234
EXPECT out3 IDX 0 EQ 5 2 3005 14 54469 26 773 37040
EXPECT pairs3 IDX 0 EQ 65535 0 3 1000 7 40000 12345 256
