#version 460
#extension GL_ARM_tensors : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) uniform readonly tensorARM<int8_t, 1> in0;
layout(set = 0, binding = 1) uniform writeonly tensorARM<int8_t, 1> out0;
layout(set = 0, binding = 2) uniform tensorARM<int8_t, 2> pairs0;
layout(set = 0, binding = 3) uniform readonly tensorARM<uint8_t, 1> in1;
layout(set = 0, binding = 4) uniform writeonly tensorARM<uint8_t, 1> out1;
layout(set = 0, binding = 5) uniform tensorARM<uint8_t, 2> pairs1;
layout(set = 0, binding = 6) uniform readonly tensorARM<int16_t, 1> in2;
layout(set = 0, binding = 7) uniform writeonly tensorARM<int16_t, 1> out2;
layout(set = 0, binding = 8) uniform tensorARM<int16_t, 2> pairs2;
layout(set = 0, binding = 9) uniform readonly tensorARM<uint16_t, 1> in3;
layout(set = 0, binding = 10) uniform writeonly tensorARM<uint16_t, 1> out3;
layout(set = 0, binding = 11) uniform tensorARM<uint16_t, 2> pairs3;

void main() {
  uint i = gl_LocalInvocationID.x;
  int8_t v0;
  tensorReadARM(in0, uint[](i), v0);
  tensorWriteARM(out0, uint[](i), v0 * int8_t(3) + int8_t(5));
  if (i < 4u) {
    int8_t pair0[2];
    tensorReadARM(pairs0, uint[](i, 0u), pair0);
    int8_t swapped0[2] = int8_t[2](pair0[1], pair0[0]);
    tensorWriteARM(pairs0, uint[](i, 0u), swapped0);
  }
  uint8_t v1;
  tensorReadARM(in1, uint[](i), v1);
  tensorWriteARM(out1, uint[](i), v1 * uint8_t(3) + uint8_t(5));
  if (i < 4u) {
