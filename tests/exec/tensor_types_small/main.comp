    tensorReadARM(pairs1, uint[](i, 0u), pair1);
    uint8_t swapped1[2] = uint8_t[2](pair1[1], pair1[0]);
    tensorWriteARM(pairs1, uint[](i, 0u), swapped1);
  }
  int16_t v2;
  tensorReadARM(in2, uint[](i), v2);
  tensorWriteARM(out2, uint[](i), v2 * int16_t(3) + int16_t(5));
  if (i < 4u) {
    int16_t pair2[2];
    tensorReadARM(pairs2, uint[](i, 0u), pair2);
    int16_t swapped2[2] = int16_t[2](pair2[1], pair2[0]);
    tensorWriteARM(pairs2, uint[](i, 0u), swapped2);
  }
  uint16_t v3;
  tensorReadARM(in3, uint[](i), v3);
  tensorWriteARM(out3, uint[](i), v3 * uint16_t(3) + uint16_t(5));
  if (i < 4u) {
    uint16_t pair3[2];
    tensorReadARM(pairs3, uint[](i, 0u), pair3);
    uint16_t swapped3[2] = uint16_t[2](pair3[1], pair3[0]);
    tensorWriteARM(pairs3, uint[](i, 0u), swapped3);
  }
}
