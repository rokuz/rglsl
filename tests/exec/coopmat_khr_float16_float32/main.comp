#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer A { float16_t a[]; };
layout(set = 0, binding = 1) buffer B { float16_t b[]; };
layout(set = 0, binding = 2) buffer C { float c[]; };
layout(set = 0, binding = 3) buffer D { float d[]; };
layout(set = 0, binding = 4) buffer E { float e[]; };
layout(set = 0, binding = 5) buffer F { float f[]; };

const uint N = 16;

void main() {
    coopmat<float16_t, gl_ScopeSubgroup, N, N, gl_MatrixUseA> ma;
    coopmat<float16_t, gl_ScopeSubgroup, N, N, gl_MatrixUseB> mb;
    coopmat<float, gl_ScopeSubgroup, N, N, gl_MatrixUseAccumulator> mc;
    coopMatLoad(ma, a, 0, N, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(mb, b, 0, N, gl_CooperativeMatrixLayoutColumnMajor);
    coopMatLoad(mc, c, 0, N, gl_CooperativeMatrixLayoutRowMajor);
    coopmat<float, gl_ScopeSubgroup, N, N, gl_MatrixUseAccumulator> md = coopMatMulAdd(ma, mb, mc);
    coopMatStore(md, d, 0, N, gl_CooperativeMatrixLayoutRowMajor);
    coopmat<float, gl_ScopeSubgroup, N, N, gl_MatrixUseAccumulator> me = -(md * 0.5) + md * md;
    me -= md * coopmat<float, gl_ScopeSubgroup, N, N, gl_MatrixUseAccumulator>(0.25);
    me += 2.0 * mc;
    coopMatStore(me, e, 0, N, gl_CooperativeMatrixLayoutColumnMajor);
    coopmat<float, gl_ScopeSubgroup, N, N, gl_MatrixUseAccumulator> mf = md;
    for (int i = 0; i < mf.length(); ++i) {
        mf[i] = (mf[i] + 1.0) * 3.0;
    }
    coopMatStore(mf, f, 0, N, gl_CooperativeMatrixLayoutRowMajor);
}
