#!amber
SHADER compute main SPIRV-BIN FILE main.spv
TENSOR t DATA_TYPE int32 DIMS 2 3 DATA
1 2 3
4 5 6
END
BUFFER r DATA_TYPE int32 SIZE 4 FILL 0
PIPELINE compute p
  ATTACH main
  BIND BUFFER t AS tensor DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER r AS storage DESCRIPTOR_SET 0 BINDING 1
END
RUN p 1 1 1
EXPECT r IDX 0 EQ 6 2 3 0
EXPECT t IDX 0 EQ 1 12 3 4 5 6
