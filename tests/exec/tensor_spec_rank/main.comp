#version 460
#extension GL_ARM_tensors : require
layout(local_size_x = 1) in;

layout(constant_id = 0) const int RANK = 2;
layout(set = 0, binding = 0) uniform tensorARM<int, RANK> t;
layout(set = 0, binding = 1) buffer Out { int r[4]; };

void main() {
  int v;
  tensorReadARM(t, uint[](1u, 2u), v);
  r[0] = v;
  r[1] = int(tensorSizeARM(t, 0));
  r[2] = int(tensorSizeARM(t, 1));
  tensorWriteARM(t, uint[](0u, 1u), v * 2);
}
