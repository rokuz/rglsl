#!amber
SHADER compute main SPIRV-BIN FILE main.spv
TENSOR in0 DATA_TYPE float16 DIMS 8 DATA 1.5 -2.25 0.125 1024.0 -3.0 0.0 7.75 -0.5 END
TENSOR out0 DATA_TYPE float16 DIMS 8 FILL 0
TENSOR pairs0 DATA_TYPE float16 DIMS 4 2 DATA 1.5 -2.25 0.125 1024.0 -3.0 0.0 7.75 -0.5 END
TENSOR in1 DATA_TYPE float DIMS 8 DATA 1.5 -2.25 0.125 1024.0 -3.0 0.0 7.75 -0.5 END
TENSOR out1 DATA_TYPE float DIMS 8 FILL 0
TENSOR pairs1 DATA_TYPE float DIMS 4 2 DATA 1.5 -2.25 0.125 1024.0 -3.0 0.0 7.75 -0.5 END
TENSOR in2 DATA_TYPE uint8 ENCODING BOOL DIMS 8 DATA 1 0 0 1 1 1 0 0 END
TENSOR out2 DATA_TYPE uint8 ENCODING BOOL DIMS 8 FILL 0
TENSOR pairs2 DATA_TYPE uint8 ENCODING BOOL DIMS 4 2 DATA 1 0 0 1 1 1 0 0 END
PIPELINE compute p
  ATTACH main
  BIND BUFFER in0 AS tensor DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER out0 AS tensor DESCRIPTOR_SET 0 BINDING 1
  BIND BUFFER pairs0 AS tensor DESCRIPTOR_SET 0 BINDING 2
  BIND BUFFER in1 AS tensor DESCRIPTOR_SET 0 BINDING 3
  BIND BUFFER out1 AS tensor DESCRIPTOR_SET 0 BINDING 4
  BIND BUFFER pairs1 AS tensor DESCRIPTOR_SET 0 BINDING 5
  BIND BUFFER in2 AS tensor DESCRIPTOR_SET 0 BINDING 6
  BIND BUFFER out2 AS tensor DESCRIPTOR_SET 0 BINDING 7
  BIND BUFFER pairs2 AS tensor DESCRIPTOR_SET 0 BINDING 8
END
RUN p 1 1 1
EXPECT out0 IDX 0 EQ 2.0 -5.5 -0.75 2047.0 -7.0 -1.0 14.5 -2.0
EXPECT pairs0 IDX 0 EQ -2.25 1.5 1024.0 0.125 0.0 -3.0 -0.5 7.75
EXPECT out1 IDX 0 EQ 2.0 -5.5 -0.75 2047.0 -7.0 -1.0 14.5 -2.0
EXPECT pairs1 IDX 0 EQ -2.25 1.5 1024.0 0.125 0.0 -3.0 -0.5 7.75
EXPECT out2 IDX 0 EQ 0 1 1 0 0 0 1 1
EXPECT pairs2 IDX 0 EQ 0 1 1 0 1 1 0 0
