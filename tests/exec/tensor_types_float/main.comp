#version 460
#extension GL_ARM_tensors : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) uniform readonly tensorARM<float16_t, 1> in0;
layout(set = 0, binding = 1) uniform writeonly tensorARM<float16_t, 1> out0;
layout(set = 0, binding = 2) uniform tensorARM<float16_t, 2> pairs0;
layout(set = 0, binding = 3) uniform readonly tensorARM<float, 1> in1;
layout(set = 0, binding = 4) uniform writeonly tensorARM<float, 1> out1;
layout(set = 0, binding = 5) uniform tensorARM<float, 2> pairs1;
layout(set = 0, binding = 6) uniform readonly tensorARM<bool, 1> in2;
layout(set = 0, binding = 7) uniform writeonly tensorARM<bool, 1> out2;
layout(set = 0, binding = 8) uniform tensorARM<bool, 2> pairs2;

void main() {
  uint i = gl_LocalInvocationID.x;
  float16_t v0;
  tensorReadARM(in0, uint[](i), v0);
  tensorWriteARM(out0, uint[](i), v0 * float16_t(2.0) - float16_t(1.0));
  if (i < 4u) {
    float16_t pair0[2];
    tensorReadARM(pairs0, uint[](i, 0u), pair0);
    float16_t swapped0[2] = float16_t[2](pair0[1], pair0[0]);
    tensorWriteARM(pairs0, uint[](i, 0u), swapped0);
  }
  float v1;
  tensorReadARM(in1, uint[](i), v1);
  tensorWriteARM(out1, uint[](i), v1 * float(2.0) - float(1.0));
  if (i < 4u) {
    float pair1[2];
    tensorReadARM(pairs1, uint[](i, 0u), pair1);
    float swapped1[2] = float[2](pair1[1], pair1[0]);
    tensorWriteARM(pairs1, uint[](i, 0u), swapped1);
  }
  bool v2;
  tensorReadARM(in2, uint[](i), v2);
  tensorWriteARM(out2, uint[](i), !v2);
  if (i < 4u) {
    bool pair2[2];
    tensorReadARM(pairs2, uint[](i, 0u), pair2);
    bool swapped2[2] = bool[2](pair2[1], pair2[0]);
    tensorWriteARM(pairs2, uint[](i, 0u), swapped2);
  }
}
