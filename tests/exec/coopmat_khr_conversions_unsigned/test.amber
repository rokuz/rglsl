BUFFER o DATA_TYPE uint32 SIZE 256 FILL 0
BUFFER h DATA_TYPE float16 SIZE 256 FILL 0
BUFFER b DATA_TYPE float SIZE 256 FILL 0
SHADER compute main SPIRV-BIN FILE main.spv
PIPELINE compute p
  ATTACH main
  BIND BUFFER c AS storage DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER o AS storage DESCRIPTOR_SET 0 BINDING 1
  BIND BUFFER h AS storage DESCRIPTOR_SET 0 BINDING 2
  BIND BUFFER b AS storage DESCRIPTOR_SET 0 BINDING 3
END
RUN p 1 1 1
