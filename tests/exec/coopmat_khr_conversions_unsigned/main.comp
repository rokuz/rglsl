#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer C { float c[256]; };
layout(set = 0, binding = 1) buffer O { uint32_t o[256]; };
layout(set = 0, binding = 2) buffer H { float16_t h[256]; };
layout(set = 0, binding = 3) buffer B { float b[256]; };

void main() {
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> mc;
    coopMatLoad(mc, c, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> ma = mc;
    for (int k = 0; k < ma.length(); ++k) {
        ma[k] = abs(ma[k]);
    }
    coopmat<uint32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> mu =
        coopmat<uint32_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(ma);
    coopMatStore(mu, o, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> mb =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(mu) * -1.0;
    coopMatStore(mb, b, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
}
