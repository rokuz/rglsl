BUFFER t DATA_TYPE float16 SIZE 256 FILL 0
BUFFER p DATA_TYPE float SIZE 256 FILL 0
BUFFER q DATA_TYPE float SIZE 256 FILL 0
SHADER compute main SPIRV-BIN FILE main.spv
PIPELINE compute p
  ATTACH main
  BIND BUFFER x AS storage DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER a AS storage DESCRIPTOR_SET 0 BINDING 1
  BIND BUFFER t AS storage DESCRIPTOR_SET 0 BINDING 2
  BIND BUFFER p AS storage DESCRIPTOR_SET 0 BINDING 3
  BIND BUFFER q AS storage DESCRIPTOR_SET 0 BINDING 4
END
