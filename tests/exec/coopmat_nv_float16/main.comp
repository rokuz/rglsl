#version 450
#extension GL_NV_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 32) in;
layout(set = 0, binding = 0) buffer A { float16_t a[]; };
layout(set = 0, binding = 1) buffer B { float16_t b[]; };
layout(set = 0, binding = 2) buffer C { float c[]; };
layout(set = 0, binding = 3) buffer D { float d[]; };
layout(set = 0, binding = 4) buffer E { float e[]; };

void main() {
    fcoopmatNV<16, gl_ScopeSubgroup, 16, 16> ma;
    fcoopmatNV<16, gl_ScopeSubgroup, 16, 16> mb;
    fcoopmatNV<32, gl_ScopeSubgroup, 16, 16> mc;
    coopMatLoadNV(ma, a, 0, 16, false);
    coopMatLoadNV(mb, b, 0, 16, true);
    coopMatLoadNV(mc, c, 0, 16, false);
    fcoopmatNV<32, gl_ScopeSubgroup, 16, 16> md = coopMatMulAddNV(ma, mb, mc);
    coopMatStoreNV(md, d, 0, 16, false);
    fcoopmatNV<32, gl_ScopeSubgroup, 16, 16> me = md * 2.0 - mc;
    coopMatStoreNV(me, e, 0, 16, true);
}
