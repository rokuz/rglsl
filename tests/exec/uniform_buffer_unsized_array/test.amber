#!amber
SHADER compute main SPIRV-BIN FILE main.spv
BUFFER ubo DATA_TYPE uint32 DATA
  100 0 0 0
  1 2 3 4
  10 20 30 40
  5 6 7 8
  11 12 13 14
END
BUFFER out_buf DATA_TYPE uint32 SIZE 4 FILL 0
PIPELINE compute p
  ATTACH main
  BIND BUFFER ubo AS uniform DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER out_buf AS storage DESCRIPTOR_SET 0 BINDING 1
END
RUN p 1 1 1
EXPECT out_buf IDX 0 EQ 110 200 126 150
