#!amber
SHADER compute main SPIRV-BIN FILE main.spv
TENSOR in0 DATA_TYPE double DIMS 8 DATA 1.5 -2.25 0.125 1024.0 -3.0 0.0 7.75 -0.5 END
TENSOR out0 DATA_TYPE double DIMS 8 FILL 0
TENSOR pairs0 DATA_TYPE double DIMS 4 2 DATA 1.5 -2.25 0.125 1024.0 -3.0 0.0 7.75 -0.5 END
PIPELINE compute p
  ATTACH main
  BIND BUFFER in0 AS tensor DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER out0 AS tensor DESCRIPTOR_SET 0 BINDING 1
  BIND BUFFER pairs0 AS tensor DESCRIPTOR_SET 0 BINDING 2
END
RUN p 1 1 1
EXPECT out0 IDX 0 EQ 2.0 -5.5 -0.75 2047.0 -7.0 -1.0 14.5 -2.0
EXPECT pairs0 IDX 0 EQ -2.25 1.5 1024.0 0.125 0.0 -3.0 -0.5 7.75
