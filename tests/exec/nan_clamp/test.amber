#!amber
SHADER compute main SPIRV-BIN FILE main.spv
BUFFER inputs DATA_TYPE uint32 DATA 2143289344 END
BUFFER results DATA_TYPE float SIZE 8 FILL 0.0
PIPELINE compute p
  ATTACH main
  BIND BUFFER inputs AS storage DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER results AS storage DESCRIPTOR_SET 0 BINDING 1
END
RUN p 1 1 1
EXPECT results IDX 0 EQ 1.0 1.5 2.0 2.5 0.5 5.0 4.0 3.0
