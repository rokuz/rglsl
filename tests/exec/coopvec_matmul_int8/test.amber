BUFFER result DATA_TYPE int32 SIZE 512 FILL 0
SHADER compute main SPIRV-BIN FILE main.spv
PIPELINE compute p
  ATTACH main
  BIND BUFFER x AS storage DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER matrix AS storage DESCRIPTOR_SET 0 BINDING 1
  BIND BUFFER bias AS storage DESCRIPTOR_SET 0 BINDING 2
  BIND BUFFER result AS storage DESCRIPTOR_SET 0 BINDING 3
END
RUN p 1 1 1
