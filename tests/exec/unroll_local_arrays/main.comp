#version 450
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Inputs { uint seeds[64]; };
layout(std430, set = 0, binding = 1) buffer Results { uint results[64]; };

void main() {
  uint id = gl_LocalInvocationIndex;
  uint s = seeds[id];
  uint a[16];
  for (int i = 0; i < 16; i++) {
    s = s * 1664525u + 1013904223u;
    a[i] = s >> 8;
  }
  for (int pass = 0; pass < 4; pass++) {
    for (int i = 0; i < 15; i++) {
      uint lo = min(a[i], a[i + 1]);
      uint hi = max(a[i], a[i + 1]);
      a[i] = lo;
      a[i + 1] = hi;
    }
  }
  uint h = 0u;
  for (int i = 0; i < 16; i++) h = h * 31u + a[i] * uint(i + 1);
  results[id] = h;
}
