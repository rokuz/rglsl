BUFFER row DATA_TYPE float16 SIZE 256 FILL 0
BUFFER col DATA_TYPE float16 SIZE 256 FILL 0
BUFFER both DATA_TYPE float16 SIZE 256 FILL 0
BUFFER quad DATA_TYPE float16 SIZE 256 FILL 0
BUFFER per DATA_TYPE float16 SIZE 256 FILL 0
SHADER compute main SPIRV-BIN FILE main.spv
PIPELINE compute p
  ATTACH main
  BIND BUFFER x AS storage DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER big AS storage DESCRIPTOR_SET 0 BINDING 1
  BIND BUFFER row AS storage DESCRIPTOR_SET 0 BINDING 2
  BIND BUFFER col AS storage DESCRIPTOR_SET 0 BINDING 3
  BIND BUFFER both AS storage DESCRIPTOR_SET 0 BINDING 4
  BIND BUFFER quad AS storage DESCRIPTOR_SET 0 BINDING 5
  BIND BUFFER per AS storage DESCRIPTOR_SET 0 BINDING 6
END
RUN p 1 1 1
