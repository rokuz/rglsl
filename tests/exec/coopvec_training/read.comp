#version 450
#extension GL_NV_cooperative_vector : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
layout(local_size_x = 16) in;
layout(set = 0, binding = 0) buffer Matrix { float16_t matrix[]; };
layout(set = 0, binding = 1) buffer Columns { float16_t columns[]; };

void main() {
    coopvecNV<float16_t, 16> unit = coopvecNV<float16_t, 16>(0.0);
    unit[gl_LocalInvocationIndex] = float16_t(1.0);
    coopvecNV<float16_t, 16> r;
    coopVecMatMulNV(r, unit, gl_ComponentTypeFloat16NV, matrix, 0, gl_ComponentTypeFloat16NV, 16, 16,
                    gl_CooperativeVectorMatrixLayoutTrainingOptimalNV, false, 0);
    coopVecStoreNV(r, columns, gl_LocalInvocationIndex * 32);
}
