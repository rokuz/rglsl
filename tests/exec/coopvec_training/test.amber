BUFFER matrix DATA_TYPE float16 SIZE 32768 FILL 0
BUFFER sums DATA_TYPE float16 SIZE 16 FILL 0
BUFFER columns DATA_TYPE float16 SIZE 256 FILL 0
SHADER compute accumulate SPIRV-BIN FILE accumulate.spv
SHADER compute read SPIRV-BIN FILE read.spv
PIPELINE compute train
  ATTACH accumulate
  BIND BUFFER a AS storage DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER b AS storage DESCRIPTOR_SET 0 BINDING 1
  BIND BUFFER matrix AS storage DESCRIPTOR_SET 0 BINDING 2
  BIND BUFFER sums AS storage DESCRIPTOR_SET 0 BINDING 3
END
PIPELINE compute check
  ATTACH read
  BIND BUFFER matrix AS storage DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER columns AS storage DESCRIPTOR_SET 0 BINDING 1
END
RUN train 1 1 1
RUN check 1 1 1
EXPECT sums IDX 0 TOLERANCE 0.1% EQ -3.0 3.0 -1.0 0.0 1.0 -3.0 3.0 -1.0 0.0 1.0 -3.0 3.0 -1.0 0.0 1.0 -3.0
