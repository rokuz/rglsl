#!amber
SHADER compute main SPIRV-BIN FILE main.spv
TENSOR in0 DATA_TYPE int32 DIMS 8 DATA -2147483648 -7 0 7 2147483647 100000 -100000 42 END
TENSOR out0 DATA_TYPE int32 DIMS 8 FILL 0
TENSOR pairs0 DATA_TYPE int32 DIMS 4 2 DATA -2147483648 -7 0 7 2147483647 100000 -100000 42 END
TENSOR in1 DATA_TYPE uint32 DIMS 8 DATA 0 4294967295 1 65536 3000000000 5 77 123456 END
TENSOR out1 DATA_TYPE uint32 DIMS 8 FILL 0
TENSOR pairs1 DATA_TYPE uint32 DIMS 4 2 DATA 0 4294967295 1 65536 3000000000 5 77 123456 END
TENSOR in2 DATA_TYPE int64 DIMS 8 DATA -9007199254740993 -1 0 1 4294967296 -4294967297 81985529216486895 3 END
TENSOR out2 DATA_TYPE int64 DIMS 8 FILL 0
TENSOR pairs2 DATA_TYPE int64 DIMS 4 2 DATA -9007199254740993 -1 0 1 4294967296 -4294967297 81985529216486895 3 END
TENSOR in3 DATA_TYPE uint64 DIMS 8 DATA 0 18446744073709551615 1 4294967296 81985529216486895 7 12 9 END
TENSOR out3 DATA_TYPE uint64 DIMS 8 FILL 0
TENSOR pairs3 DATA_TYPE uint64 DIMS 4 2 DATA 0 18446744073709551615 1 4294967296 81985529216486895 7 12 9 END
PIPELINE compute p
  ATTACH main
  BIND BUFFER in0 AS tensor DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER out0 AS tensor DESCRIPTOR_SET 0 BINDING 1
  BIND BUFFER pairs0 AS tensor DESCRIPTOR_SET 0 BINDING 2
  BIND BUFFER in1 AS tensor DESCRIPTOR_SET 0 BINDING 3
  BIND BUFFER out1 AS tensor DESCRIPTOR_SET 0 BINDING 4
  BIND BUFFER pairs1 AS tensor DESCRIPTOR_SET 0 BINDING 5
  BIND BUFFER in2 AS tensor DESCRIPTOR_SET 0 BINDING 6
  BIND BUFFER out2 AS tensor DESCRIPTOR_SET 0 BINDING 7
  BIND BUFFER pairs2 AS tensor DESCRIPTOR_SET 0 BINDING 8
  BIND BUFFER in3 AS tensor DESCRIPTOR_SET 0 BINDING 9
  BIND BUFFER out3 AS tensor DESCRIPTOR_SET 0 BINDING 10
  BIND BUFFER pairs3 AS tensor DESCRIPTOR_SET 0 BINDING 11
END
RUN p 1 1 1
EXPECT out0 IDX 0 EQ -2147483643 -16 5 26 -2147483646 300005 -299995 131
EXPECT pairs0 IDX 0 EQ -7 -2147483648 7 0 100000 2147483647 42 -100000
EXPECT out1 IDX 0 EQ 5 2 8 196613 410065413 20 236 370373
