#!amber
SHADER compute main SPIRV-BIN FILE main.spv
TENSOR t DATA_TYPE int32 DIMS 3 4 DATA
1 2 3 4
11 12 13 14
21 22 23 24
END
TENSOR w DATA_TYPE int32 DIMS 5 FILL 0
BUFFER r DATA_TYPE int32 SIZE 20 FILL -100
PIPELINE compute p
  ATTACH main
  BIND BUFFER t AS tensor DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER w AS tensor DESCRIPTOR_SET 0 BINDING 1
  BIND BUFFER r AS storage DESCRIPTOR_SET 0 BINDING 2
END
RUN p 1 1 1
EXPECT r IDX 0 EQ 24 0 0 -7 12 13 14 99 3 4 0 1 2 3 5 5 5 3 4 5
EXPECT w IDX 0 EQ 31 11 0 21 22
