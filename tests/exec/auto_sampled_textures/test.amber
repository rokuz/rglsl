#!amber
SHADER compute main SPIRV-BIN FILE main.spv
IMAGE image DATA_TYPE vec4<float> DIM_2D WIDTH 2 HEIGHT 2 FILL 0.25
SAMPLER nearest
BUFFER results DATA_TYPE vec4<float> SIZE 3 FILL 0.0
PIPELINE compute p
  ATTACH main
  BIND BUFFER image AS combined_image_sampler SAMPLER nearest DESCRIPTOR_SET 0 BINDING 0
  BIND BUFFER results AS storage DESCRIPTOR_SET 0 BINDING 2
END
RUN p 1 1 1
EXPECT results IDX 0 EQ 0.25 0.25 0.25 0.25 0.5 0.5 0.5 0.5 2.0 2.0 0.0 1.0
