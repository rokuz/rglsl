#version 450
#extension GL_AMD_gcn_shader : require
#extension GL_ARB_gpu_shader_int64 : require
layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 0) buffer Inputs { vec4 directions[6]; };
layout(std430, set = 0, binding = 1) buffer Results { int faces[6]; int ordered; };

void main() {
  uint64_t before = timeAMD();
  for (int i = 0; i < 6; ++i) {
    faces[i] = int(cubeFaceIndexAMD(directions[i].xyz));
  }
  uint64_t after = timeAMD();
  ordered = int(after >= before);
}
