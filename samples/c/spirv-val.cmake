file(GLOB modules "${DIRECTORY}/*.spv")
if(NOT modules)
    message(FATAL_ERROR "no SPIR-V modules in ${DIRECTORY}")
endif()
foreach(module IN LISTS modules)
    execute_process(COMMAND "${SPIRV_VAL}" --target-env vulkan1.1 "${module}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "spirv-val: ${module} is not valid")
    endif()
    message("spirv-val: ${module} is valid")
endforeach()
